<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A consumer of the packed LocalStack.Client.Extensions package, published with Native AOT by the
    native-aot-tests CI job. It is deliberately outside the solution and isolated from the repository's
    build props, central package versions and generator wiring, so it sees only what a NuGet consumer sees.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LocalStack.Client.Extensions" Version="$(LocalStackVersion)" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.18" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
