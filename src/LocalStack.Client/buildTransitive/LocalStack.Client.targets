<Project>
  <!-- Adds the client registry source generator to consumers whose target framework gets the modern assets.
       LocalStackClientGeneratorMinimumTargetFramework comes from the generated LocalStack.Client.props in this folder. -->
  <ItemGroup Condition="'$(TargetFramework)' != '' and '$(LocalStackClientGeneratorMinimumTargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', '$(LocalStackClientGeneratorMinimumTargetFramework)'))">
    <Analyzer Include="$(MSBuildThisFileDirectory)../tools/LocalStack.Client.Generators/LocalStack.Client.Generators.dll" />
  </ItemGroup>
</Project>
