<Project>
  <!--
    Which shape of the internal Amazon.Extensions.NETCore.Setup.ClientFactory<T> we build and test against.
    AWS changed its constructor in AWSSDK.Extensions.NETCore.Setup 4.0.4 (see issue #52):

      <= 4.0.3.40  ClientFactory(AWSOptions awsOptions)
      >= 4.0.4     ClientFactory(AWSOptions awsOptions, Action<ClientConfig, IServiceProvider> configAction = null)

    The version must move for the WHOLE graph at once - src and tests together - otherwise NuGet
    reports NU1605 (package downgrade), which is an error here because TreatWarningsAsErrors is on.
    That is why this is a central switch rather than a per-project VersionOverride.

      current (default) - post-4.0.4 shape, the version consumers realistically resolve
      legacy            - pre-4.0.4 shape, proves backwards compatibility
      latest            - floating, scheduled canary ONLY (never in a reproducible build)
  -->
  <PropertyGroup>
    <AwsSetupTrack Condition="'$(AwsSetupTrack)' == ''">current</AwsSetupTrack>
  </PropertyGroup>

  <!-- Floating versions are opt-in under Central Package Management (NU1011). Enable them ONLY for the
       scheduled canary, so 'current' and 'legacy' stay strictly reproducible. -->
  <PropertyGroup Condition="'$(AwsSetupTrack)' == 'latest'">
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(AwsSetupTrack)' == 'current'">
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.100.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(AwsSetupTrack)' == 'legacy'">
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3.40" />
  </ItemGroup>
  <ItemGroup Condition="'$(AwsSetupTrack)' == 'latest'">
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- third-party analyzers -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.134" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
