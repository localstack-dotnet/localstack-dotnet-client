<Project>
    <PropertyGroup>
        <Authors>LocalStack.NET, Deniz İrgin</Authors>
        <Company>LocalStack.NET</Company>
        <Owners>LocalStack.NET</Owners>
        <PackageProjectUrl>https://github.com/localstack-dotnet/localstack-dotnet-client</PackageProjectUrl>
        <PackageIcon>localstack-dotnet-square.png</PackageIcon>
        <PackageMainVersion>3.0.0</PackageMainVersion>
        <PackageExtensionVersion>3.0.0</PackageExtensionVersion>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>13.0</LangVersion>
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <AnalysisLevel>latest</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Audit transitive dependencies consistently across all frameworks and build tools. -->
        <NuGetAuditMode Condition="'$(NuGetAuditMode)' == ''">all</NuGetAuditMode>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <NoWarn>
        $(NoWarn);
        </NoWarn>
        <NoError>
        $(NoError);
        </NoError>
        <ReportAnalyzer>true</ReportAnalyzer>
        <AnalysisMode>All</AnalysisMode>
        <Features>strict</Features>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>

        <!-- Enable central package management -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

        <!-- Which AWS SDK versions to build against: 'current' (pinned, the default) or
             'latest' (floating, scheduled canary only). See Directory.Packages.props. -->
        <AwsSetupTrack Condition="'$(AwsSetupTrack)' == ''">current</AwsSetupTrack>

        <!-- Floating versions are opt-in under central package management (NU1011). -->
        <CentralPackageFloatingVersionsEnabled Condition="'$(AwsSetupTrack)' == 'latest'">true</CentralPackageFloatingVersionsEnabled>

        <!-- Target frameworks. "Modern" targets get Native AOT support, the source generator and the
             reflection-free client creation paths; add a new .NET version here and everything follows. -->
        <LocalStackModernMinimumTargetFramework>net10.0</LocalStackModernMinimumTargetFramework>
        <LocalStackModernTargetFrameworks>$(LocalStackModernMinimumTargetFramework);net11.0</LocalStackModernTargetFrameworks>
        <LocalStackNetStandardTargetFramework>netstandard2.0</LocalStackNetStandardTargetFramework>
        <LocalStackNetFrameworkTargetFramework>net472</LocalStackNetFrameworkTargetFramework>

        <LocalStackClientTargetFrameworks>$(LocalStackNetStandardTargetFramework);$(LocalStackNetFrameworkTargetFramework);$(LocalStackModernTargetFrameworks)</LocalStackClientTargetFrameworks>
        <LocalStackExtensionsTargetFrameworks>$(LocalStackNetStandardTargetFramework);$(LocalStackModernTargetFrameworks)</LocalStackExtensionsTargetFrameworks>
        <!-- Test projects that also run on .NET Framework. -->
        <LocalStackNetFrameworkAndModernTargetFrameworks>$(LocalStackNetFrameworkTargetFramework);$(LocalStackModernTargetFrameworks)</LocalStackNetFrameworkAndModernTargetFrameworks>

        <!-- Package validation compares each package with this published version. -->
        <LocalStackPackageValidationBaselineVersion>2.0.0</LocalStackPackageValidationBaselineVersion>
        <!-- Assets the baseline has and this release drops on purpose (.NET 8/9 end of support; those apps use netstandard2.0). -->
        <LocalStackPackageValidationDroppedTargetFrameworks>net8.0;net9.0</LocalStackPackageValidationDroppedTargetFrameworks>

    </PropertyGroup>

    <!-- True in the inner build of a modern target framework; false elsewhere (including the outer build). -->
    <PropertyGroup>
        <IsLocalStackModernTarget>false</IsLocalStackModernTarget>
        <IsLocalStackModernTarget Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', '$(LocalStackModernMinimumTargetFramework)'))">true</IsLocalStackModernTarget>
        <IsLocalStackNetFrameworkTarget>false</IsLocalStackNetFrameworkTarget>
        <IsLocalStackNetFrameworkTarget Condition="'$(TargetFramework)' == '$(LocalStackNetFrameworkTargetFramework)'">true</IsLocalStackNetFrameworkTarget>
    </PropertyGroup>

    <!-- third-party analyzers -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Roslynator.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Roslynator.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Roslynator.Formatting.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="SonarAnalyzer.CSharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Meziantou.Analyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="SecurityCodeScan.VS2019">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="TestableIO.System.IO.Abstractions.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="Properties/BannedSymbols.txt" />
        <Compile Include="$(MSBuildThisFileDirectory)/AssemblyInfo.cs" Link="Properties/AssemblyInfo.common.cs" />
    </ItemGroup>
</Project>
