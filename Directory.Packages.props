<Project>
  <!-- The two packages we depend on structurally. $(AwsSetupTrack) floats them for the scheduled
       canary so AWS moving under us is caught early, as it was not for 4.0.4 (issue #52). -->
  <ItemGroup Condition="'$(AwsSetupTrack)' != 'latest'">
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.6" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(AwsSetupTrack)' == 'latest'">
    <PackageVersion Include="AWSSDK.Core" Version="4.*" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
